{
  "name": "radiation-gamma-monitor",
  "version": "1.0.0",
  "description": "Advanced Radiation Gamma Monitor with Offline Map",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .",
    "build:renderer": "vite build",
    "build:electron": "npm run build:renderer && electron-builder",
    "build": "npm run build:renderer && electron-builder --win",
    "build:linux": "npm run build:renderer && electron-builder --linux",
    "rebuild": "electron-rebuild",
    "download-tiles": "node scripts/download-tiles.js"
  },
  "build": {
    "appId": "com.radiationmonitor.app",
    "productName": "Radiation Gamma Monitor",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "src/main/**/*",
      "src/renderer/dist/**/*",
      "src/assets/**/*"
    ],
    "extraResources": [
      {
        "from": "src/assets/offline-tiles",
        "to": "offline-tiles"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-devtools-installer": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "dayjs": "^1.11.21",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.0",
    "serialport": "^13.0.0",
    "sql.js": "^1.14.1",
    "uuid": "^14.0.1"
  }
}
